{
  "openapi": "3.0.0",
  "info": {"title": "Sample", "version": "1.0.0"},
  "paths": {
    "/api/login": {
      "post": {
        "operationId": "login",
        "summary": "Login",
        "security": []
      }
    },
    "/api/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Current user",
        "security": [{"bearerAuth": []}]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer"}
    }
  }
}
